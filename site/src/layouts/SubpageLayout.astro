---
import BaseLayout from './BaseLayout.astro';
import { SITE_URL, pageBySlug } from '../data/site';

interface Props {
  slug: string;
  title: string;
  description: string;
  /** The page's h1, also the JSON-LD headline. */
  headline: string;
  lead: string;
  schemaType: 'WebPage' | 'TechArticle';
  datePublished: string;
}

const { slug, title, description, headline, lead, schemaType, datePublished } = Astro.props;
const { label } = pageBySlug(slug);
const url = `${SITE_URL}${slug}/`;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  headline,
  name: title,
  description,
  url,
  mainEntityOfPage: url,
  inLanguage: 'en',
  datePublished,
  author: { '@type': 'Person', name: 'Joshua Potter' },
  about: { '@type': 'SoftwareApplication', name: 'Replay Buffer Pro', url: SITE_URL },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Replay Buffer Pro', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: label, item: url },
  ],
};
---
<BaseLayout title={title} description={description} root="../">
  <Fragment slot="head">
    <!-- Open Graph -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="article">
    <meta property="og:image" content="https://raw.githubusercontent.com/JoshuaPotter/replay-buffer-pro/main/screenshot.png">
    <meta property="og:url" content={url}>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content="https://raw.githubusercontent.com/JoshuaPotter/replay-buffer-pro/main/screenshot.png">

    <meta name="author" content="Joshua Potter">
    <meta name="theme-color" content="#000000">
    <meta name="color-scheme" content="dark">
    <link rel="canonical" href={url}>
    <link rel="alternate" type="text/markdown" href={`../${slug}.md`} title="Markdown version of this page">
    <link rel="alternate" type="text/plain" href="../llms.txt" title="LLM-optimized documentation">

    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema, null, 2)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema, null, 2)}></script>
  </Fragment>

  <section class="page-head">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          <li><a href="../">Replay Buffer Pro</a></li>
          <li aria-current="page">{label}</li>
        </ol>
      </nav>
      <h1>{headline}</h1>
      <p class="hero-lead">{lead}</p>
    </div>
  </section>

  <slot />
</BaseLayout>
