---
import BaseLayout from './BaseLayout.astro';
import SocialMeta from '../components/SocialMeta.astro';
import JsonLd from '../components/ui/JsonLd.astro';
import { AUTHOR, SITE_URL, pageBySlug } from '../data/site';
import { gitDate } from '../lib/repo';

interface Props {
  slug: string;
  title: string;
  description: string;
  /** The page's h1, also the JSON-LD headline. */
  headline: string;
  lead: string;
  schemaType: 'WebPage' | 'TechArticle';
  datePublished: string;
}

const { slug, title, description, headline, lead, schemaType, datePublished } = Astro.props;
const { label, sources } = pageBySlug(slug);
const url = `${SITE_URL}${slug}/`;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  headline,
  name: title,
  description,
  url,
  mainEntityOfPage: url,
  inLanguage: 'en',
  datePublished,
  // The last commit to the page's sources, the same date its sitemap.xml entry uses.
  dateModified: gitDate(sources),
  author: { '@type': 'Person', name: AUTHOR },
  about: { '@type': 'SoftwareApplication', name: 'Replay Buffer Pro', url: SITE_URL },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Replay Buffer Pro', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: label, item: url },
  ],
};
---
<BaseLayout title={title} description={description} root="../">
  <Fragment slot="head">
    <SocialMeta title={title} description={description} type="article" url={url} />
    <link rel="canonical" href={url}>
    <link rel="alternate" type="text/markdown" href={`../${slug}.md`} title="Markdown version of this page">
    <link rel="alternate" type="text/plain" href="../llms.txt" title="LLM-optimized documentation">

    <JsonLd data={pageSchema} />
    <JsonLd data={breadcrumbSchema} />
  </Fragment>

  <section class="page-head">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          <li><a href="../">Replay Buffer Pro</a></li>
          <li aria-current="page">{label}</li>
        </ol>
      </nav>
      <h1>{headline}</h1>
      <p class="hero-lead">{lead}</p>
    </div>
  </section>

  <slot />
</BaseLayout>

<style>
  .page-head { padding: clamp(3.5rem, 8vw, 6rem) 0 clamp(1rem, 3vw, 2rem); }
  .page-head .hero-lead { max-width: 40rem; }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    font-size: .8125rem;
    color: var(--text-faint);
  }
  .crumbs li + li::before { content: "/"; margin-right: .5rem; color: var(--gray-500); }
  .crumbs a { transition: color .15s ease; }
  .crumbs a:hover { color: var(--text); }
</style>
