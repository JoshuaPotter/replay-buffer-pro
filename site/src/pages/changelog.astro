---
import { getCollection, render } from 'astro:content';
import SubpageLayout from '../layouts/SubpageLayout.astro';
import ExternalLink from '../components/ui/ExternalLink.astro';
import Section from '../components/ui/Section.astro';
import { RELEASES_URL } from '../data/site';

const releases = await Promise.all(
  (await getCollection('changelog'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (release) => ({ ...release.data, Content: (await render(release)).Content })),
);
const longDate = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' });
---
<SubpageLayout
  slug="changelog"
  title="Replay Buffer Pro Changelog | Release History"
  description="Release history for Replay Buffer Pro, the OBS Studio plugin for saving replay buffer clips at any length, from 1.0.0 to the latest version."
  headline="Changelog"
  lead="What changed in each release of Replay Buffer Pro. Full release notes and downloads are on GitHub."
  schemaType="WebPage"
  datePublished="2026-10-05"
>
  <Section>
    {releases.map(({ version, date, Content }) => (
      <section class="release" id={`v${version.replaceAll('.', '-')}`}>
        <div class="release-meta">
          <h2><ExternalLink href={`${RELEASES_URL}/tag/${version}`}>{version}</ExternalLink></h2>
          <time datetime={date}>{longDate(date)}</time>
        </div>
        <div class="prose">
          <Content />
        </div>
      </section>
    ))}
  </Section>
</SubpageLayout>

<style>
  .release {
    display: grid;
    grid-template-columns: 1fr;
    gap: .75rem 2rem;
    padding: 2rem 0;
    border-top: 1px solid var(--border);
  }
  .release:first-child { border-top: 0; padding-top: 0; }
  .release-meta h2 { font-size: 1.5rem; letter-spacing: -0.035em; }
  .release-meta time {
    display: block;
    margin-top: .375rem;
    font-size: .8125rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .release .prose { max-width: 40rem; }
  .release .prose :global(p),
  .release .prose :global(li) { font-size: .9375rem; }
  .release .prose > :global(p:first-child) { color: var(--text); }

  @media (min-width: 48rem) {
    .release { grid-template-columns: 11rem 1fr; }
  }
</style>
