---
import { getCollection, render } from 'astro:content';
import SubpageLayout from '../layouts/SubpageLayout.astro';

const releases = await Promise.all(
  (await getCollection('changelog'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (release) => ({ ...release.data, Content: (await render(release)).Content })),
);
const longDate = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' });
---
<SubpageLayout
  slug="changelog"
  title="Replay Buffer Pro Changelog | Release History"
  description="Release history for Replay Buffer Pro, the OBS Studio plugin for saving replay buffer clips at any length, from 1.0.0 to the latest version."
  headline="Changelog"
  lead="What changed in each release of Replay Buffer Pro. Full release notes and downloads are on GitHub."
  schemaType="WebPage"
  datePublished="2026-10-05"
>
  <section class="section">
    <div class="container">
      {releases.map(({ version, date, Content }) => (
        <section class="release" id={`v${version.replaceAll('.', '-')}`}>
          <div class="release-meta">
            <h2><a href={`https://github.com/JoshuaPotter/replay-buffer-pro/releases/tag/${version}`} rel="noopener" target="_blank">{version}</a></h2>
            <time datetime={date}>{longDate(date)}</time>
          </div>
          <div class="prose">
            <Content />
          </div>
        </section>
      ))}
    </div>
  </section>
</SubpageLayout>
