---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import Section from '../components/ui/Section.astro';

// GitHub Pages serves this file for any missing path, at any depth, so relative
// links would break. This is the one page whose links start at the site root.
const root = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout
  title="Page not found | Replay Buffer Pro"
  description="This page doesn't exist. Go to the Replay Buffer Pro homepage or the usage guide."
  root={root}
>
  <meta slot="head" name="robots" content="noindex">

  <Section class="not-found">
    <p class="not-found-code mono">404</p>
    <h1>Page not found</h1>
    <p class="hero-lead">This page doesn't exist or has moved.</p>
    <div class="cta-row">
      <ButtonLink variant="primary" size="lg" href={root}>Go to the homepage</ButtonLink>
      <ButtonLink variant="secondary" size="lg" href={`${root}usage/`}>How to use it</ButtonLink>
    </div>
  </Section>
</BaseLayout>

<style>
  .not-found { padding-top: clamp(4rem, 10vw, 7rem); }
  .not-found-code {
    margin-bottom: 1.25rem;
    color: var(--text-faint);
  }
</style>
