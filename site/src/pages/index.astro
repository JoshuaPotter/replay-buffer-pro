  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <a class="release-pill" href="https://github.com/JoshuaPotter/replay-buffer-pro/releases" rel="noopener" target="_blank">
