                  <div class="buffer-number-steppers">
                    <button type="button" class="buffer-number-step" id="buffer-step-up" aria-label="Increase buffer length">
                      <svg width="8" height="5" viewBox="0 0 8 5" fill="none">
                        <path d="M1 4l3-3 3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <button type="button" class="buffer-number-step" id="buffer-step-down" aria-label="Decrease buffer length">
                      <svg width="8" height="5" viewBox="0 0 8 5" fill="none">
                        <path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <div class="plugin-section">
              <div class="plugin-section-header">
                <h3 class="plugin-section-title">Save Clips</h3>
                <button type="button" class="customize-btn" id="customize-btn" aria-haspopup="dialog">Customize</button>
              </div>

              <div class="clip-buttons-grid">
                <button class="clip-btn">Last 15 Seconds</button>
                <button class="clip-btn">Last 30 Seconds</button>
                <button class="clip-btn">Last 1 Minute</button>
                <button class="clip-btn">Last 5 Minutes</button>
                <button class="clip-btn">Last 15 Minutes</button>
                <button class="clip-btn">Last 30 Minutes</button>
              </div>

              <button class="save-buffer-btn">Save Replay Buffer</button>
            </div>
          </div>
        </div>

        <!-- Customize Save Buttons Modal (panel-scoped) -->
        <div id="customize-modal" class="demo-modal-overlay" aria-hidden="true">
          <div class="demo-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
            <div class="demo-modal-header">
              <span id="modal-title" class="demo-modal-title">Customize Save Buttons</span>
              <button type="button" class="demo-modal-close" id="modal-close" aria-label="Close">
