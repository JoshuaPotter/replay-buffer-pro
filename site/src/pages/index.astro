<script>
  import { detectOS } from '../scripts/os';
  import { getLatestRelease } from '../scripts/release';

  // Windows/macOS tabs for the install steps, defaulting to the visitor's OS.
  const tabs = document.querySelectorAll<HTMLElement>('[data-os-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-os-panel]');
  const selectOS = (os: string) => {
    tabs.forEach((tab) => {
      const selected = tab.dataset.osTab === os;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.osPanel !== os;
    });
  };
  tabs.forEach((tab) => tab.addEventListener('click', () => selectOS(tab.dataset.osTab ?? '')));

  // Arrow keys, Home and End move between tabs and select the one they land on.
  const tabList = [...tabs];
  tabList.forEach((tab, i) => {
    tab.addEventListener('keydown', (e) => {
      const last = tabList.length - 1;
      const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      selectOS(tabList[next].dataset.osTab ?? '');
      tabList[next].focus();
    });
  });
  selectOS(detectOS());

  // Show the latest release's version in the hero pill.
  getLatestRelease().then((release) => {
    if (!release) return;
    document.querySelectorAll<HTMLElement>('.release-version').forEach((el) => {
      el.textContent = `${el.dataset.prefix ?? 'v'}${release.tag_name}`;
    });
  });
</script>
