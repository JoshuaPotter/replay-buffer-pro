  .spec-row:last-child { border-bottom: 0; }
  .spec-list dt { font-size: .875rem; color: var(--text-faint); }
  .spec-list dd { margin: 0; font-size: .875rem; color: var(--text); }
  .spec-list dd .spec-line { display: block; }
  .spec-list dd .spec-line + .spec-line { margin-top: .25rem; }
  .os-tablist {
