---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadSplit from '../components/DownloadSplit.astro';
import SocialMeta from '../components/SocialMeta.astro';
import FactStrip from '../components/FactStrip.astro';
import FeatureRow from '../components/FeatureRow.astro';
import CodeSample from '../components/CodeSample.astro';
import PluginDemo from '../components/PluginDemo.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import Card from '../components/ui/Card.astro';
import CopyCode from '../components/ui/CopyCode.astro';
import ExternalLink from '../components/ui/ExternalLink.astro';
import Issue from '../components/ui/Issue.astro';
import JsonLd from '../components/ui/JsonLd.astro';
import Section from '../components/ui/Section.astro';
import Surface from '../components/ui/Surface.astro';
import ArrowRight from '../icons/arrow-right.svg';
import { clipButtons } from '../data/demo';
import { AUTHOR, ISSUES_URL, LATEST_RELEASE_URL, RELEASES_URL, REPO_URL, SCREENSHOT_URL, SITE_URL, VERSION } from '../data/site';

const softwareApplication = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Replay Buffer Pro",
  "description": "OBS Studio plugin for saving replay buffer clips at multiple customizable durations without re-encoding. Perfect for streamers, gamers, and content creators.",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "Windows 10/11 (64-bit), macOS 13.0+",
  "softwareVersion": VERSION,
  "datePublished": "2025-03-06",
  "isAccessibleForFree": true,
  "sameAs": [
    REPO_URL
  ],
  "author": {
    "@type": "Person",
    "name": AUTHOR
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "downloadUrl": LATEST_RELEASE_URL,
  "softwareRequirements": "OBS Studio 32.2.0+",
  "keywords": "OBS Studio, plugin, replay buffer, streaming, recording, clip, gaming, instant replay",
  "screenshot": SCREENSHOT_URL
};

const sourceCode = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "name": "Replay Buffer Pro",
  "description": "OBS Studio plugin for saving replay buffer clips at multiple customizable durations",
  "codeRepository": REPO_URL,
  "programmingLanguage": "C++",
  "runtimePlatform": "Windows 10/11 (64-bit), macOS 13.0+",
  "license": "https://www.gnu.org/licenses/gpl-2.0.html",
  "targetProduct": {
    "@type": "SoftwareApplication",
    "name": "OBS Studio",
    "version": "32.2.0+"
  }
};

const installHowTo = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Install Replay Buffer Pro for OBS Studio",
  "description": "Step-by-step guide to install Replay Buffer Pro plugin for OBS Studio on Windows or macOS",
  "totalTime": "PT5M",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Download Plugin",
      "text": "Download the latest release of Replay Buffer Pro for your platform (Windows .zip or macOS .pkg) from the link above.",
      "url": LATEST_RELEASE_URL
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Close OBS Studio",
      "text": "Make sure OBS Studio is completely closed before proceeding."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Install the Plugin",
      "text": "On Windows, extract the ZIP and copy the replay-buffer-pro folder to C:\\ProgramData\\obs-studio\\plugins\\. On macOS, open the .pkg and follow the installer, which installs to ~/Library/Application Support/obs-studio/plugins/ automatically.",
      "url": LATEST_RELEASE_URL
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Restart OBS Studio",
      "text": "Restart OBS Studio and open Docks → Replay Buffer Pro to get started."
    }
  ]
};

// Renders both the #faq section and the FAQPage JSON-LD, whose answers are
// these HTML answers with the tags removed.
const faq = [
  {
    question: "How is this different from OBS Studio's default Replay Buffer?",
    answer: `The default saves a single fixed duration clip. Replay Buffer Pro lets you save multiple customizable lengths on demand with buttons or hotkeys, and trims each one automatically.`
  },
  {
    question: "Why would I use this?",
    answer: `It captures recent moments from your stream or recording in whatever length you need, without manual clipping. It behaves like the "Save Recent Gameplay" feature on Xbox and PlayStation — press once, get a trimmed clip ready for TikTok, YouTube Shorts, or Instagram Reels.`
  },
  {
    question: "Does it re-encode video?",
    answer: `No. Trimming is a stream copy through FFmpeg's libavformat — the equivalent of <code>-c copy</code> — so it is fast and lossless.`
  },
  {
    question: "Does saving a short clip write the whole buffer to disk?",
    answer: `Yes, briefly. OBS Studio's replay buffer saves as one complete file, and there isn't currently a way for plugins to save just part of it. So the full buffer is written first, then Replay Buffer Pro trims a copy to the length you chose and deletes the full-length file. If OBS Studio adds a way to save part of the buffer in the future, the plugin will use it. Until then, each save writes the same amount as OBS Studio's own Save Replay, plus the short trimmed clip. For example, a 15-minute buffer at 40 Mbps is about 4.5 GB per save, which is small next to the rated write endurance of a modern SSD. If you save often at high bitrates and want fewer writes on your SSD, keep the buffer length modest or point your Replay Buffer save directory at another drive.`
  },
  {
    question: "Why are some save buttons disabled?",
    answer: `Your configured buffer length is shorter than that clip length. Increase the buffer length, or choose a shorter clip.`
  },
  {
    question: "Why can't I change the buffer length right now?",
    answer: `The Replay Buffer is active. Stop it to adjust the length, then start it again.`
  },
  {
    question: "Can I customize the save button durations?",
    answer: `Yes. Use the <strong>Customize</strong> button in the Save Clips section to set each button's duration.`
  },
  {
    question: "Where are clips saved?",
    answer: `In your OBS Studio Replay Buffer save directory, set in OBS Studio's Output settings.`
  },
  {
    question: "Can other apps save clips through OBS WebSocket?",
    answer: `Yes. Turn on the server in <strong>Tools → WebSocket Server Settings</strong>, then have your app send a <code>CallVendorRequest</code> with <code>vendorName</code> <code>replay-buffer-pro</code>, <code>requestType</code> <code>SaveClip</code> and <code>requestData</code> <code>{"duration": "2:00"}</code>. The duration can be seconds (<code>120</code>) or text such as <code>"5:22"</code>, <code>"1:05:00"</code> or <code>"1h30m"</code>, from 1 second to 6 hours. The Replay Buffer must be running, and asking for more than your buffer holds saves the whole buffer. See <a href="usage/#obs-websocket">how to use Replay Buffer Pro</a> for the full request and response format.`
  }
];

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": answer.replace(/<[^>]+>/g, '')
    }
  }))
};

const facts = [
  'No re-encoding',
  'Trims in milliseconds',
  'Six custom durations',
  'Hotkey for every button',
  'Windows & macOS',
  'Same output folder',
];

const hotkeys = clipButtons.slice(0, 5).map(({ label }, i) => ({ label: `Save ${label}`, keys: ['Ctrl', 'Alt', `${i + 1}`] }));
---
<BaseLayout
  title="Replay Buffer Pro - An OBS Studio Plugin"
  description="An OBS Studio plugin for saving replay buffer clips at multiple customizable durations without re-encoding."
  root=""
>
  <Fragment slot="head">
    <SocialMeta
      title="Replay Buffer Pro, a plugin for OBS Studio"
      twitterTitle="Replay Buffer Pro - OBS Studio Plugin"
      description="Save the last moments of your stream or recording with one click. Instantly clip customizable durations without re-encoding."
      type="website"
      url={SITE_URL}
    />

    <!-- Enhanced meta -->
    <meta name="keywords" content="OBS Studio, plugin, replay buffer, streaming, recording, clip, gaming, twitch, youtube, instant replay, obs plugin, video clipping, content creation, gaming clips">
    <meta name="application-name" content="Replay Buffer Pro">
    <meta name="msapplication-TileColor" content="#000000">

    <!-- Canonical URL -->
    <link rel="canonical" href={SITE_URL}>

    <!-- LLM-optimized content -->
    <link rel="alternate" type="text/plain" href="llms.txt" title="LLM-optimized documentation">

    <!-- AI-Specific Meta Tags -->
    <meta property="product:category" content="Software">
    <meta property="product:price:amount" content="0">
    <meta property="product:price:currency" content="USD">

    <!-- Schema.org Item Properties -->
    <meta itemprop="name" content="Replay Buffer Pro">
    <meta itemprop="description" content="OBS Studio plugin for saving replay buffer clips at multiple customizable durations without re-encoding">
    <meta itemprop="image" content={SCREENSHOT_URL}>

    <JsonLd data={softwareApplication} />
    <JsonLd data={sourceCode} />
    <JsonLd data={faqPage} />
    <JsonLd data={installHowTo} />
  </Fragment>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <ExternalLink class="release-pill" href={RELEASES_URL}>
          <span class="release-version" data-prefix="v">v{VERSION}</span>
          <span class="release-pill-text">available now</span>
          <ArrowRight />
        </ExternalLink>

        <h1>Save the moment you didn't know you'd need</h1>
        <p class="hero-lead">Replay Buffer Pro adds a dock to OBS Studio for saving the last 15 seconds — or the last 30 minutes — of whatever just happened. Trimmed instantly, without re-encoding.</p>

        <div class="cta-row">
          <DownloadSplit variant="hero" />
          <ButtonLink variant="secondary" size="lg" href="#how-it-works">See how it works</ButtonLink>
        </div>

        <p class="hero-meta">Free and open source · Requires OBS Studio 32.2.0+</p>
      </div>

      <div class="hero-media">
        <!-- Framed product surface, mimicking the OBS dock in situ -->
        <Surface label="OBS Studio — Docks → Replay Buffer Pro" chrome bodyClass="plugin-ui-stage-wrap">
          <PluginDemo />
        </Surface>
      </div>
    </div>

    <!-- Fact strip, in place of Vercel's customer logo band -->
    <div class="container">
      <FactStrip facts={facts} />
    </div>
  </section>

  <!-- ============ HOW IT WORKS — alternating feature rows ============ -->
  <Section id="how-it-works">
    <FeatureRow
      title="One buffer, any clip length"
      points={[
        'Six save buttons, each with its own duration',
        'Each duration is fully customizable, from 1 second to 6 hours',
        'No trip to Settings → Output — edit the length right in the dock',
      ]}
    >
      <Fragment slot="statement"><strong>Keep a long buffer running</strong> and hit whichever save button matches what just happened. The plugin saves the buffer, then trims it back to exactly that button's duration.</Fragment>
      <Surface slot="media">
          <div class="timeline" role="img" aria-label="A 10 minute replay buffer with the last 30 seconds highlighted as the saved clip">
            <div class="timeline-head">
              <span class="timeline-title">Replay buffer</span>
              <span class="timeline-len">600s</span>
            </div>
            <div class="timeline-track">
              <div class="timeline-fill"></div>
              <div class="timeline-window"><span class="timeline-window-label">30s</span></div>
              <div class="timeline-now" aria-hidden="true"></div>
            </div>
            <div class="timeline-axis">
              <span>oldest frame in buffer</span><span>now</span>
            </div>
            <div class="timeline-out">
              <span class="mono">Replay 2026-08-14 21-04-33_trimmed.mkv</span>
              <span class="tag tag-ok">saved · 30.0s</span>
            </div>
          </div>
      </Surface>
    </FeatureRow>

    <FeatureRow
      title="Trimmed without re-encoding"
      reverse
      points={[
        'Identical quality to the source buffer',
        'Skips the CPU/GPU-heavy encode pass',
        'OBS keeps recording while it trims',
      ]}
    >
      <Fragment slot="statement"><strong>Nothing gets re-rendered.</strong> Replay Buffer Pro just repackages the footage your buffer already captured, so the clip keeps the exact bitrate, codec, and quality of the original — and lands in about the time it takes to write the file.</Fragment>
      <CodeSample slot="media" label="OBS Studio log" wrap><code><span class="log-dim">21:04:33.118:</span> <span class="log-key">[ReplayBufferPro]</span> SAVE STATE: armed gen=1 duration=30s
<span class="log-dim">21:04:33.301:</span> <span class="log-key">[ReplayBufferPro]</span> Trimming replay buffer save to 30 seconds
<span class="log-dim">21:04:33.302:</span> <span class="log-key">[ReplayBufferPro]</span> Input video duration: 600.02 seconds
<span class="log-dim">21:04:33.303:</span> <span class="log-key">[ReplayBufferPro]</span> Cutting at keyframe 570.00 seconds (requested 570.02, drift 0.02)
<span class="log-dim">21:04:33.489:</span> <span class="log-ok">[ReplayBufferPro]</span> TRIM VERDICT: ok file='Replay 2026-08-14 21-04-33_trimmed.mkv' requested=30s actual=30.0s source=600.0s cut_at=570.0s elapsed=0.4s</code></CodeSample>
    </FeatureRow>

    <FeatureRow
      title="Never leave the game to clip"
      points={[
        'A hotkey for every duration, not just one save-all key',
        'Search "Replay Buffer Pro" in OBS Settings → Hotkeys',
        'No alt-tab required',
      ]}
    >
      <Fragment slot="statement"><strong>Every save button gets a hotkey.</strong> Bind them in OBS Studio's own hotkey settings and clip mid-broadcast without alt-tabbing or touching your mouse.</Fragment>
      <Surface slot="media" label="Settings → Hotkeys · example bindings">
        <ul class="keymap">
          {hotkeys.map(({ label, keys }) => (
            <li><span>{label}</span><span class="keys">{keys.map((key) => <kbd>{key}</kbd>)}</span></li>
          ))}
        </ul>
      </Surface>
    </FeatureRow>
  </Section>

  <!-- ============ USE CASES ============ -->
  <Section id="use-cases" title={'Built for anyone who says "wait, did I get that?"'}>
    <div class="card-grid card-grid-2">
      <Card eyebrow="Streaming & content creation">
        <p>Twitch and YouTube streamers can capture a highlight the second it happens and walk away with a clip already sized for TikTok, YouTube Shorts, and Instagram Reels — no editor, no export queue.</p>
      </Card>
      <Card eyebrow="Sports & esports analysis">
        <p>Coaches and analysts can pull gameplay segments at precise moments for review and breakdown, without post-processing delays or scrubbing through hours of VOD.</p>
      </Card>
      <Card eyebrow="Tutorial & educational content">
        <p>Educators and tutorial creators can grab specific segments of a recording at whatever length each platform wants, straight out of the session.</p>
      </Card>
      <Card eyebrow="Software development & QA">
        <p>Developers and QA testers can save a bug reproduction the moment it occurs, with the exact preceding context attached to the ticket.</p>
      </Card>
    </div>
  </Section>

  <!-- ============ INSTALL ============ -->
  <Section id="install" title="Get started" lead="Requirements, installation, and setup.">
    <dl class="spec-list">
      <div class="spec-row">
        <dt>OBS Studio</dt>
        <dd>32.2.0+</dd>
      </div>
      <div class="spec-row">
        <dt>Operating System</dt>
        <dd>
          <span class="spec-line">Windows 10/11 (64-bit)</span>
          <span class="spec-line">macOS 13.0+ (Apple Silicon &amp; Intel universal)</span>
        </dd>
      </div>
    </dl>

    <div class="os-tabs" data-os-tabs>
      <div class="os-tablist" role="tablist" aria-label="Choose your operating system">
        <button type="button" class="os-tab" role="tab" id="tab-windows" aria-controls="panel-windows" data-os-tab="windows">Windows</button>
        <button type="button" class="os-tab" role="tab" id="tab-macos" aria-controls="panel-macos" data-os-tab="macos">macOS</button>
      </div>

      <ol class="os-tabpanel" role="tabpanel" id="panel-windows" aria-labelledby="tab-windows" data-os-panel="windows">
        <li><span class="os-step-text">Download the <code>.zip</code> for Windows (x64).</span></li>
        <li><span class="os-step-text">Quit OBS Studio completely.</span></li>
        <li><span class="os-step-text">Extract the <code>.zip</code> and copy the <code>replay-buffer-pro</code> folder into <CopyCode>%ALLUSERSPROFILE%\obs-studio\plugins\</CopyCode> (typically <CopyCode>C:\ProgramData\obs-studio\plugins\</CopyCode>).</span></li>
        <li><span class="os-step-text">Restart OBS Studio — the dock is under <strong>Docks → Replay Buffer Pro</strong>.</span></li>
      </ol>

      <ol class="os-tabpanel" role="tabpanel" id="panel-macos" aria-labelledby="tab-macos" data-os-panel="macos">
        <li><span class="os-step-text">Download the universal <code>.pkg</code>.</span></li>
        <li><span class="os-step-text">Quit OBS Studio completely.</span></li>
        <li><span class="os-step-text">Open the <code>.pkg</code> and follow the installer — it writes to <code>~/Library/Application Support/obs-studio/plugins/</code> automatically. If macOS blocks it as coming from an unidentified developer, Control-click the <code>.pkg</code>, choose <strong>Open</strong>, and confirm.</span></li>
        <li><span class="os-step-text">Restart OBS Studio — the dock is under <strong>Docks → Replay Buffer Pro</strong>.</span></li>
      </ol>
    </div>

    <h3 class="subhead">Then, in OBS Studio</h3>
    <ol class="numbered-list">
      <li><span>Open <strong>Docks → Replay Buffer Pro</strong>.</span></li>
      <li><span>Set the maximum replay buffer length in the dock's numeric field.</span></li>
      <li><span>Start the Replay Buffer from OBS Studio's controls.</span></li>
      <li><span>Hit a save button — or its hotkey — to write the clip.</span></li>
    </ol>
  </Section>

  <!-- ============ FAQ ============ -->
  <Section id="faq" title="Frequently asked questions">
    <div class="faq">
      {faq.map(({ question, answer }) => (
        <details>
          <summary>{question}<span class="faq-icon" aria-hidden="true"></span></summary>
          <div class="faq-body"><p set:html={answer}></p></div>
        </details>
      ))}
    </div>
  </Section>

  <!-- ============ TROUBLESHOOTING ============ -->
  <Section id="troubleshooting" title="Troubleshooting">
    <div class="issue-list">
      <Issue title="Plugin not loading">
        <p>On Windows, confirm <code>replay-buffer-pro.dll</code> sits in <CopyCode>%ALLUSERSPROFILE%\obs-studio\plugins\replay-buffer-pro\bin\64bit\</CopyCode> (typically <CopyCode>C:\ProgramData\obs-studio\plugins\replay-buffer-pro\bin\64bit\</CopyCode>). On macOS, confirm <CopyCode>~/Library/Application Support/obs-studio/plugins/replay-buffer-pro.plugin</CopyCode> exists. Then restart OBS Studio.</p>
      </Issue>
      <Issue title="A clip wasn't trimmed">
        <p>Every replay save writes one <code>TRIM VERDICT</code> line to the OBS log (<strong>Help → Log Files → Show Log Files</strong>). Search for <code>TRIM VERDICT</code> and find the line for that clip — the <code>reason</code> field names the cause. A failed trim always leaves your original full-length clip in place, so nothing is lost.</p>
        <p><code>skipped reason=no-pending-request</code> means the save came from outside the plugin — OBS's own <strong>Save Replay</strong> hotkey, the tray menu, or a Stream Deck button using the official OBS Studio plugin's "Save Replay Buffer" action. Those save the full buffer. Bind a <em>Replay Buffer Pro: Save…</em> hotkey instead so the plugin knows which duration you wanted.</p>
        <p><code>skipped reason=encoder-paused</code> means recording was paused. OBS doesn't save the replay buffer while recording is paused, so resume recording and save again. <code>skipped reason=replay-buffer-stopped</code> means the replay buffer was stopped before OBS started writing the clip. A save pressed while OBS is still writing a previous clip waits for that write to finish, then is trimmed so it ends at the moment you pressed the key. If your replay buffer no longer holds anything from before that press, the trim fails with <code>failed reason=window-not-in-buffer</code> and the full-length file is kept; increase the buffer length or save to faster storage.</p>
        <p><code>failed reason=output-too-long</code> means your encoder's keyframe interval is too long for the clip length you asked for. Set <strong>Settings → Output → Keyframe Interval</strong> to 2 seconds. For <code>failed reason=open-input-failed</code>, try disabling <strong>Settings → Advanced → Automatically remux to mp4</strong>; antivirus and cloud-sync folders can hold the file the same way. For anything else, check disk space and write permissions in the output directory.</p>
      </Issue>
      <Issue title="Check the logs">
        <p>Open the OBS Studio log file (<strong>Help → Log Files → Show Log Files</strong>) and search for <code>[ReplayBufferPro]</code> to see load messages and errors.</p>
      </Issue>
      <Issue title="Report an issue">
        <p>Still stuck? <ExternalLink href={ISSUES_URL}>File an issue on GitHub</ExternalLink> with your OBS Studio version, plugin version, and any relevant log lines.</p>
      </Issue>
    </div>
  </Section>
</BaseLayout>

<style>
  .hero { padding: clamp(3.5rem, 8vw, 7rem) 0 0; }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }
  .release-pill {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    height: 1.875rem;
    padding: 0 .75rem;
    margin-bottom: 1.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-full);
    background: var(--bg-raised);
    font-size: .8125rem;
    color: var(--text-muted);
    transition: border-color .15s ease, background-color .15s ease;
  }
  .release-pill:hover { border-color: var(--gray-500); background: var(--gray-100); }
  .release-pill .release-version { color: var(--text); font-weight: 500; font-variant-numeric: tabular-nums; }
  .release-pill :global(svg) { color: var(--text-faint); transition: transform .15s ease; }
  .release-pill:hover :global(svg) { transform: translateX(2px); }
  .hero-meta {
    margin-top: 1.25rem;
    font-size: .8125rem;
    color: var(--text-faint);
  }
  .hero-media { min-width: 0; }
  :global(.plugin-ui-stage-wrap) { position: relative; }
  .subhead {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 1.25rem;
    font-size: 1.125rem;
    color: var(--text);
  }
  .timeline-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: .875rem;
  }
  .timeline-title { font-size: .8125rem; color: var(--text-muted); }
  .timeline-len {
    font-family: var(--font-mono);
    font-size: .75rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .timeline-track {
    position: relative;
    height: 3.5rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--bg-subtle);
    overflow: hidden;
  }
  .timeline-fill {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      90deg,
      var(--gray-200) 0 2px,
      transparent 2px 7px
    );
  }
  .timeline-window {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 22%;
    background: var(--gray-1000);
    display: grid;
    place-items: center;
  }
  .timeline-window-label {
    font-family: var(--font-mono);
    font-size: .75rem;
    font-weight: 500;
    color: #000;
  }
  .timeline-now {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 2px;
    background: var(--green);
  }
  .timeline-axis {
    display: flex;
    justify-content: space-between;
    margin-top: .5rem;
    font-family: var(--font-mono);
    font-size: .6875rem;
    color: var(--text-faint);
  }
  .timeline-out {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: .75rem;
    color: var(--text-faint);
  }
  .keymap { margin: 0; padding: 0; list-style: none; }
  .keymap li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .75rem 0;
    border-bottom: 1px solid var(--border);
    font-size: .875rem;
    color: var(--text-muted);
  }
  .keymap li:last-child { border-bottom: 0; padding-bottom: 0; }
  .keymap li:first-child { padding-top: 0; }
  .keys { display: inline-flex; gap: .25rem; flex-shrink: 0; }
  kbd {
    min-width: 1.5rem;
    padding: .1875rem .375rem;
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    border-radius: var(--r-sm);
    background: var(--gray-100);
    font-family: var(--font-mono);
