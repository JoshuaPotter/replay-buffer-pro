                  <div class="demo-modal-input-wrap">
                    <input type="number" class="demo-modal-input" id="btn-input-3" min="1" max="21600" value="300">
                    <span class="demo-modal-unit">sec</span>
                  </div>
                </div>
                <div class="demo-modal-row">
                  <label class="demo-modal-label" for="btn-input-4">Button 5</label>
                  <div class="demo-modal-input-wrap">
                    <input type="number" class="demo-modal-input" id="btn-input-4" min="1" max="21600" value="900">
                    <span class="demo-modal-unit">sec</span>
                  </div>
                </div>
                <div class="demo-modal-row">
                  <label class="demo-modal-label" for="btn-input-5">Button 6</label>
                  <div class="demo-modal-input-wrap">
