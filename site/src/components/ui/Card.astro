---
interface Props {
  eyebrow: string;
  title?: string;
}

const { eyebrow, title } = Astro.props;
---
<article class="card card-lg">
  <span class="card-eyebrow">{eyebrow}</span>
  {title && <h3>{title}</h3>}
  <slot />
</article>

<style>
  .card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    background: var(--bg-raised);
    transition: border-color .15s ease, background-color .15s ease;
  }
  .card:hover { border-color: var(--border-strong); background: var(--bg-subtle); }
  .card-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-lg);
    color: var(--text);
  }
  .card h3 { margin-bottom: .5rem; }
  .card :global(p) { font-size: .875rem; color: var(--text-muted); }
  .card :global(a) { color: var(--blue-light); text-decoration: underline; text-underline-offset: 2px; }
  .card :global(a:hover) { color: var(--text); }
  .card-lg { padding: 1.75rem; }
  .card-lg :global(p) { font-size: .9375rem; line-height: 1.65; }
  .card-eyebrow {
    display: block;
    margin-bottom: .875rem;
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
</style>
