---
// A bordered panel for product visuals, with an optional labelled top bar.
interface Props {
  label?: string;
  /** Sets the label in the mono font. */
  mono?: boolean;
  bodyClass?: string;
}

const { label, mono, bodyClass } = Astro.props;
---
<div class="surface">
  {label && (
    <div class="surface-bar">
      <span class:list={['surface-label', { mono }]}>{label}</span>
    </div>
  )}
  <div class:list={['surface-body', bodyClass]}><slot /></div>
</div>
