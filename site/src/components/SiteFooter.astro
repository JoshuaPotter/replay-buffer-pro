---
import DownloadSplit from './DownloadSplit.astro';
import Brand from './ui/Brand.astro';
import ExternalLink from './ui/ExternalLink.astro';
import { ISSUES_URL, PAGES, RELEASES_URL, REPO_URL, SECTION_LINKS } from '../data/site';

interface Props {
  /** Relative path to the site root: '' on the homepage, '../' on subpages. */
  root: string;
}

const { root } = Astro.props;

interface FooterLink {
  href: string;
  label: string;
  external?: boolean;
}

const columns: { heading: string; links: FooterLink[] }[] = [
  {
    heading: 'Quickstart',
    links: Object.values(SECTION_LINKS).map(({ hash, label }) => ({ href: `${root}${hash}`, label })),
  },
  {
    heading: 'Explore',
    links: PAGES.map((page) => ({ href: `${root}${page.slug}/`, label: page.label })),
  },
  {
    heading: 'Resources',
    links: [
      { href: REPO_URL, label: 'GitHub repository', external: true },
      { href: `${REPO_URL}#replay-buffer-pro`, label: 'Documentation', external: true },
      { href: RELEASES_URL, label: 'Releases', external: true },
      { href: ISSUES_URL, label: 'Report an issue', external: true },
      { href: `${root}llms.txt`, label: 'llms.txt' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { href: 'https://www.gnu.org/licenses/old-licenses/gpl-2.0.html', label: 'GPL-2.0-or-later', external: true },
    ],
  },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand-col">
        <Brand root={root} />
        <p class="footer-blurb">An OBS Studio plugin for saving replay buffer clips at any length, without re-encoding.</p>
        <DownloadSplit variant="footer" />
      </div>

      {columns.map(({ heading, links }) => (
        <div class="footer-col">
          <h2>{heading}</h2>
          <ul>
            {links.map(({ label, external, ...attrs }) => {
              const Link = external ? ExternalLink : 'a';
              return <li><Link {...attrs}>{label}</Link></li>;
            })}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer-bottom">
      <p>© <span class="year"></span> Replay Buffer Pro. Licensed under GPL v2 or later.</p>
      <p class="footer-disclaimer">Replay Buffer Pro is an independent project, not affiliated with, endorsed by, or sponsored by OBS Studio or its developers. All product names and trademarks are the property of their respective owners.</p>
      <p><a class="footer-top" href="#top">Back to top</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(3rem, 6vw, 4.5rem) 0 2rem;
    border-top: 1px solid var(--border);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  .footer-brand-col { max-width: 20rem; }
  .footer-blurb {
    margin-top: 1rem;
    font-size: .875rem;
    line-height: 1.6;
    color: var(--text-faint);
  }
  .footer-col h2 {
    margin-bottom: 1rem;
    font-size: .8125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .footer-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }
  .footer-col :global(a) {
    font-size: .875rem;
    color: var(--text-faint);
    transition: color .15s ease;
  }
  .footer-col :global(a:hover) { color: var(--text); }
  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }
  .footer-bottom p { font-size: .75rem; color: var(--text-faint); }
  .footer-disclaimer { max-width: 46rem; line-height: 1.6; }
  .footer-top { transition: color .15s ease; }
  .footer-top:hover { color: var(--text); }

  @media (min-width: 48rem) {
    .footer-grid { grid-template-columns: repeat(4, 1fr); gap: 3rem; }
    .footer-brand-col { grid-column: 1 / -1; }
    .footer-bottom { flex-direction: row; align-items: baseline; justify-content: space-between; gap: 2rem; }
    .footer-bottom p:first-child,
    .footer-bottom p:last-child { flex-shrink: 0; }
  }

  @media (min-width: 60rem) {
    .footer-grid { grid-template-columns: 1.5fr repeat(4, 1fr); }
    .footer-brand-col { grid-column: auto; }
  }
</style>

<script>
  document.querySelectorAll('.year').forEach((el) => {
    el.textContent = String(new Date().getFullYear());
  });
</script>
