---
import DownloadSplit from './DownloadSplit.astro';
import Brand from './ui/Brand.astro';
import ButtonLink from './ui/ButtonLink.astro';
import GitHub from '../icons/github.svg';
import { REPO_URL, SECTION_LINKS } from '../data/site';

interface Props {
  /** Relative path to the site root: '' on the homepage, '../' on subpages. */
  root: string;
}

const { root } = Astro.props;
const { howItWorks, install, faq } = SECTION_LINKS;
const nav = [
  { href: `${root}${howItWorks.hash}`, label: howItWorks.label },
  { href: `${root}${install.hash}`, label: install.label },
  { href: `${root}usage/`, label: 'Usage' },
  { href: `${root}${faq.hash}`, label: faq.label },
];
---
<header class="site-header">
  <div class="container header-inner">
    <Brand root={root} />

    <nav class="header-nav" aria-label="Sections">
      {nav.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>

    <div class="header-actions">
      <ButtonLink variant="secondary" iconOnly external href={REPO_URL} aria-label="View on GitHub">
        <GitHub />
      </ButtonLink>
      <DownloadSplit variant="header" />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(0, 0, 0, .72);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
  }
  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-right: auto;
  }
  .header-nav a {
    font-size: .875rem;
    color: var(--text-muted);
    transition: color .15s ease;
  }
  .header-nav a:hover { color: var(--text); }
  .header-actions {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-shrink: 0;
  }

  @media (max-width: 60rem) {
    /* Below the desktop breakpoint the header nav links are dropped in
       favour of the download action, which is what the page is for. */
    .header-nav { display: none; }
    .header-inner > :global(.brand) { margin-right: auto; }
  }
</style>
