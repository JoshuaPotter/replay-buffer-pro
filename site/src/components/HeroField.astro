---
// The homepage hero's animated halftone field, rendered with vgpu (WebGPU). It fills the
// nearest positioned ancestor, lights from the element marked [data-hero-flare] in it and stays
// quiet behind the one marked [data-hero-calm].
// Browsers without WebGPU never reveal the canvas, so the hero stays flat black.
---
<canvas class="hero-field" data-hero-field aria-hidden="true"></canvas>

<style>
  .hero-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.6s ease;
    /* Dissolve into the page at the top, above the fact strip and at the far edges. */
    mask-image:
      linear-gradient(to bottom, transparent, black 14%, black 60%, transparent 92%),
      radial-gradient(150% 110% at 50% 42%, black 45%, transparent 85%);
    mask-composite: intersect;
  }
  /* Overall strength of the effect; the canvas fades in to this. */
  .hero-field.is-ready { opacity: .6; }

  @media (max-width: 60rem) {
    .hero-field {
      /* The shader keeps the copy itself clear, so the field can reach beside it. */
      mask-image: linear-gradient(to bottom, transparent, black 12%, black 75%, transparent 96%);
    }
  }
</style>

<script>
  // vgpu is about 56 KB gzipped, so only browsers with WebGPU download it.
  const canvases = document.querySelectorAll<HTMLCanvasElement>('[data-hero-field]');
  if ('gpu' in navigator && canvases.length) {
    const { initHeroField } = await import('../scripts/hero-field');
    canvases.forEach((canvas) => {
      const find = (name: string) => canvas.parentElement?.querySelector<HTMLElement>(`[${name}]`) ?? null;
      void initHeroField(canvas, find('data-hero-flare'), find('data-hero-calm'));
    });
  }
</script>
